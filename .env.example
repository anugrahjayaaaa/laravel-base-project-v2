APP_NAME="Laravel Base Project"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_base
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Redis (optional, not required for base)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Pennant (feature flags), stores resolved flag values
PENNANT_STORE=database

# Laravel Telescope + Periscope (debug tooling, see ADR-020)
# Default false. Enabling on a VM also needs:
#   php artisan config:clear && php artisan config:cache
#   sudo systemctl reload php8.3-fpm      # opcache keeps the old value
# Disable again the same way, then prune:
#   php artisan telescope:prune --hours=6
TELESCOPE_ENABLED=false
PERISCOPE_ENABLED=false
