APP_NAME="Laravel Base Project"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# The version string published in the OpenAPI document (`/docs/api.json`).
API_VERSION=v1

# Comma-separated origins allowed to call the API cross-origin (scheme + host +
# port, no trailing slash). Empty = default-deny: no CORS grant is emitted at
# all. Credentials are enabled only when at least one origin is named. No
# wildcard — a `*` entry would echo every caller's origin with credentials.
# Examples:
#   CORS_ALLOWED_ORIGINS=https://app.example.com
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_base
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
# Default (zero extra infrastructure — DEP-006). Set CACHE_STORE=redis and
# SESSION_DRIVER=redis when a Redis server is available; both are drop-in
# swaps, no code change.
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# Sanctum token lifetime and idle browser-session lifetime are system settings
# (Settings → Rate Limits & Expirations), not env values.

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Redis (optional, not required for base — see DEP-006)
# REDIS_HOST is the SERVER address as seen FROM THE APP. When the app runs on
# the host and Redis in Docker, that is 127.0.0.1 (Docker publishes the port);
# the name `redis` only resolves inside the compose network, where the app
# container itself would live.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Separate databases, so `redis-cli flushdb` on the cache cannot take the queue
# with it. Queue -> DB 0 (config/queue.php uses the `default` connection),
# cache -> DB 1.
REDIS_DB=0
REDIS_CACHE_DB=1
# MUST be greater than the worker --timeout (bin/run-workers.sh QUEUE_TIMEOUT,
# default 90). On the redis driver a job is held in a `reserved` sorted set for
# retry_after seconds; if that is <= the timeout, a job still running when its
# timeout elapses becomes visible to a second worker and runs twice. The
# database driver is not affected — it reserves the row atomically at pop time.
REDIS_QUEUE_RETRY_AFTER=180

# Laravel Pennant (feature flags), stores resolved flag values
PENNANT_STORE=database

# Laravel Pulse (replaces Telescope + Periscope for lightweight observability)
PULSE_ENABLED=true

# Pulse's own cache store. Leave this on `array` unless you have read
# PulseQueryCacheTest: a persistent driver (redis, file, database) hands cached
# objects back as __PHP_Incomplete_Class because cache.serializable_classes is
# false (phase-1 hardening), and every Pulse card crashes on a warm cache. The
# cost of `array` is per-process state — Servers heartbeat, pulse:check signals.
PULSE_CACHE_DRIVER='array'

# Vantage (queue monitor). The runtime kill switch is the `vantage` feature flag
# at /features; this key is the deploy-time one, like PULSE_ENABLED.
VANTAGE_ENABLED=true

# Vantage job-payload storage. Keep false: the package default is true, which
# persists full job payloads (export filters, model ids, mail arguments) that
# redaction does not cover. See config/vantage.php and ADR-022.
VANTAGE_STORE_PAYLOAD=false
