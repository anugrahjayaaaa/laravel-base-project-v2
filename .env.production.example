# Copy to the VM only. Never commit the filled version.
APP_NAME="Laravel Base Project"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://34.128.73.234

LOG_CHANNEL=stack
LOG_LEVEL=info

# Google Cloud SQL MySQL
DB_CONNECTION=mysql
DB_HOST=136.64.40.1
DB_PORT=3306
DB_DATABASE=laravel-base-project-v2
DB_USERNAME=admin
DB_PASSWORD="#Password123"
MYSQL_ATTR_SSL_CA=/etc/ssl/cloudsql/server-ca.pem

# Existing application defaults
BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Optional Redis. Use only if the VM can reach the Redis instance.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Mail provider
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SCHEME=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Pennant
PENNANT_STORE=database

# Keep disabled unless production Telescope access is explicitly configured.
PERISCOPE_ENABLED=false
