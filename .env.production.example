# Copy to the VM as:
# /var/www/laravel-base-project-v2/.env
# Never commit the filled production file.
APP_NAME="Laravel Base Project"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://replace-with-production-domain

LOG_CHANNEL=stack
LOG_LEVEL=info

# Google Cloud SQL MySQL
DB_CONNECTION=mysql
DB_HOST=replace-with-cloudsql-private-ip
DB_PORT=3306
DB_DATABASE=replace-with-database
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password
MYSQL_ATTR_SSL_CA=/path/to/cloudsql-ca.pem

BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Redis configuration. Drop-in swap for CACHE_STORE / SESSION_DRIVER above —
# no application code changes either way (DEP-006).
REDIS_CLIENT=phpredis
# Address of the Redis server AS SEEN FROM THE APP: `redis` when the app runs
# in the same Docker network, the published host address when it does not.
REDIS_HOST=replace-with-redis-host
REDIS_PASSWORD=replace-with-redis-password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# MUST exceed the worker --timeout (bin/run-workers.sh QUEUE_TIMEOUT, default
# 90). Equal or lower lets a still-running job be picked up a second time.
REDIS_QUEUE_RETRY_AFTER=180

MAIL_MAILER=smtp
MAIL_HOST=replace-with-mail-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

PENNANT_STORE=database

# Laravel Pulse (replaces Telescope + Periscope for lightweight observability)
PULSE_ENABLED=true
