# Copy to the VM as:
# /var/www/laravel-base-project-v2/.env
# Never commit the filled production file.
APP_NAME="Laravel Base Project"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://replace-with-production-domain

LOG_CHANNEL=stack
LOG_LEVEL=info

# Google Cloud SQL MySQL
DB_CONNECTION=mysql
DB_HOST=replace-with-cloudsql-private-ip
DB_PORT=3306
DB_DATABASE=replace-with-database
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password
MYSQL_ATTR_SSL_CA=/path/to/cloudsql-ca.pem

BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Optional Redis configuration.
REDIS_CLIENT=phpredis
REDIS_HOST=replace-with-redis-host
REDIS_PASSWORD=replace-with-redis-password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=replace-with-mail-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

PENNANT_STORE=database
PERISCOPE_ENABLED=false
