APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:/2AvOyazTQqXA3g6NajdDFCG3aRVDQE4GBHMdpP61ak=
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# array, not redis: a test run must not need a Redis server, and must not share
# cache/session state with the dev database. This file is what phpunit.xml's
# APP_ENV=testing selects, and it wins over `.env` — keep it that way.
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=log
