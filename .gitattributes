# Normalise line endings: rsync copies these bytes to the VM unchanged, and a
# CRLF shell script fails on the shebang with `\r: command not found`.
* text=auto eol=lf

*.blade.php text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.php text eol=lf

# Binary — never let git try to normalise these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.zip binary
*.gz binary
